<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/obs_accent_pressed" />
            <corners android:radius="3dp" />
            <stroke android:width="1dp" android:color="@color/obs_gold_dim" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/obs_accent" />
            <corners android:radius="3dp" />
            <stroke android:width="1dp" android:color="@color/obs_gold" />
        </shape>
    </item>
</selector>
