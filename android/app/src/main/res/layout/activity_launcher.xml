<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed dark shell: brand-forward rail + content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obs_bg"
    android:orientation="horizontal"
    android:padding="0dp">

    <LinearLayout
        android:id="@+id/nav_rail"
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:background="@color/obs_rail"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/brand_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:paddingStart="4dp"
            android:paddingBottom="2dp"
            android:text="OBSIDIAN"
            android:textColor="@color/obs_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingBottom="28dp"
            android:text="Classic realm client"
            android:textAllCaps="true"
            android:textColor="@color/obs_gold"
            android:textSize="10sp"
            android:letterSpacing="0.12" />

        <Button
            android:id="@+id/nav_home"
            style="@style/ObsidianRailButton"
            android:text="Home" />

        <Button
            android:id="@+id/nav_signin"
            style="@style/ObsidianRailButton"
            android:layout_marginTop="4dp"
            android:text="Sign in" />

        <Button
            android:id="@+id/nav_graphics"
            style="@style/ObsidianRailButton"
            android:layout_marginTop="4dp"
            android:text="Graphics" />

        <Button
            android:id="@+id/nav_audio"
            style="@style/ObsidianRailButton"
            android:layout_marginTop="4dp"
            android:text="Audio" />

        <Button
            android:id="@+id/nav_controls"
            style="@style/ObsidianRailButton"
            android:layout_marginTop="4dp"
            android:text="Controls" />

        <Button
            android:id="@+id/nav_paths"
            style="@style/ObsidianRailButton"
            android:layout_marginTop="4dp"
            android:text="Data" />

        <Button
            android:id="@+id/nav_about"
            style="@style/ObsidianRailButton"
            android:layout_marginTop="4dp"
            android:text="About" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_play"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_primary_button"
            android:text="Enter World"
            android:textAllCaps="false"
            android:textColor="@color/obs_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/obs_stroke" />

    <FrameLayout
        android:id="@+id/content_host"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/obs_bg"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <ViewFlipper
            android:id="@+id/content_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include layout="@layout/panel_home" />
            <include layout="@layout/panel_signin" />
            <include layout="@layout/panel_graphics" />
            <include layout="@layout/panel_audio" />
            <include layout="@layout/panel_controls" />
            <include layout="@layout/panel_paths" />
            <include layout="@layout/panel_about" />
        </ViewFlipper>
    </FrameLayout>
</LinearLayout>
