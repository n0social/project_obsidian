<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/ObsidianSectionTitle"
            android:text="Home" />

        <TextView
            style="@style/ObsidianSectionSubtitle"
            android:paddingBottom="18dp"
            android:text="Add your 1.12 client under Data, then your server and account under Sign in." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:text="Status"
                android:textColor="@color/obs_gold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/home_device_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:textColor="@color/obs_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/home_data_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textColor="@color/obs_text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/home_realm_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textColor="@color/obs_gold"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_hint_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:textColor="@color/obs_accent"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
