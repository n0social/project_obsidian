<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SDLActivity extends android.app.Activity — avoid AppCompat-only themes. -->
    <style name="Theme.Obsidian" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/obs_bg</item>
        <item name="android:statusBarColor">@color/obs_bg</item>
        <item name="android:navigationBarColor">@color/obs_bg</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.Obsidian.Launcher" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/obs_bg</item>
        <item name="android:statusBarColor">@color/obs_bg</item>
        <item name="android:navigationBarColor">@color/obs_bg</item>
        <item name="android:colorPrimary">@color/obs_accent</item>
        <item name="android:textColorPrimary">@color/obs_text</item>
        <item name="android:textColorSecondary">@color/obs_text_muted</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="ObsidianRailButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/obs_text</item>
        <item name="android:background">@drawable/bg_rail_button</item>
    </style>

    <style name="ObsidianSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/obs_text</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="ObsidianSectionSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/obs_text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingBottom">18dp</item>
    </style>

    <style name="ObsidianFieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/obs_gold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>
